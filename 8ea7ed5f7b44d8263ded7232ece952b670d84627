      "writtenOn": "2026-05-08T16:59:23Z",
      "side": 1,
      "message": "That was a fascinating bit of morning reading, thanks! I agree that we probably should stick with the Chromium guideline in this case.",
      "parentUuid": "f6f1ddae_dc9737d7",
      "range": {
        "startLine": 46,
        "startChar": 33,
        "endLine": 46,
        "endChar": 42
      },
      "revId": "8ea7ed5f7b44d8263ded7232ece952b670d84627",
