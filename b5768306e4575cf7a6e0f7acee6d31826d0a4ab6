      "writtenOn": "2024-11-16T05:39:01Z",
      "side": 1,
      "message": "Yes, BlitTextureToBuffer requires 4 bytes aligned because D3D11\u0027s compute can only write to 4 bytes aligned address.",
      "parentUuid": "d777f801_1299b442",
      "range": {
        "startLine": 268,
        "startChar": 0,
        "endLine": 268,
        "endChar": 69
