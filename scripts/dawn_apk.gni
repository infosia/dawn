import("//build/config/android/rules.gni")
import("dawn_overrides_with_defaults.gni")

template("android_manifest_gen") {
  outer_target = target_name
  forward_variables_from(invoker, "*")
  action("make_manifest_" + target_name) {
    script = "${dawn_root}/generator/android_manifest_generator.py"
    outfile = "$target_gen_dir/$outer_target/AndroidManifest.xml"
    args = [
      "--target-name",
      outer_target,
      "--out",
      rebase_path(outfile, root_build_dir),
    ]
    outputs = [ outfile ]
  }
}

template("dawn_apk") {
  manifest_path = "$target_gen_dir/$target_name/AndroidManifest.xml"
  android_manifest_gen(target_name) {
  }
  shared_library("_" + target_name) {
    forward_variables_from(invoker, "*")
    configs -= [ "//build/config/android:hide_all_but_jni_onload" ]
  }
  android_apk(target_name) {
    apk_name = target_name

    deps = [
      ":_$target_name",
      ":make_manifest_$target_name",
    ]

    android_manifest = manifest_path
    android_manifest_dep = ":make_manifest_$target_name"
    shared_libraries = [ ":_$target_name" ]
  }
}
