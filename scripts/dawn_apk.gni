import("//build/config/android/rules.gni")
import("dawn_overrides_with_defaults.gni")

# Build an Android APK containing:
#  - a generated AndroidManifest.xml for this target_name
#  - lib<target_name>Main.so that contains all the sources and libs from the invoker
template("dawn_apk") {
  manifest_path = "${target_gen_dir}/${target_name}/AndroidManifest.xml"
  outer_target = target_name
  action("android_manifest_" + target_name) {
    script = "${dawn_root}/generator/android_manifest_generator.py"
    args = [
      "--target-name",
      outer_target,
      "--out",
      rebase_path(manifest_path, root_build_dir),
    ]
    outputs = [ manifest_path ]
  }
  shared_library(target_name + "Main") {
    forward_variables_from(invoker, "*")
    configs -= [ "//build/config/android:hide_all_but_jni_onload" ]

    if (!build_with_chromium) {
      ldflags = [ "-static-libstdc++" ]
    }
  }
  android_apk(target_name) {
    apk_name = target_name
    android_manifest = manifest_path
    android_manifest_dep = ":android_manifest_${target_name}"
    shared_libraries = [ ":${target_name}Main" ]
  }
}
