import("dawn_features.gni")
import("dawn_overrides_with_defaults.gni")

# Centralized config for -Weverything and its suppressions.
config("dawn_everything_warnings") {
  if (using_pinned_clang) {
    cflags = [ "-Weverything" ]

    # Suppressions (allowlist)
    # This list will be populated as we enable -Weverything incrementally.
    cflags += [
      "-Wno-c++98-compat",
      "-Wno-c++98-compat-pedantic",
      "-Wno-pre-c++14-compat",
      "-Wno-pre-c++17-compat",
      "-Wno-pre-c++20-compat",
      "-Wno-padded",
      "-Wno-zero-as-null-pointer-constant",
      "-Wno-old-style-cast",
      "-Wno-sign-conversion",
      "-Wno-undef",
      "-Wno-reserved-macro-identifier",
      "-Wno-undefined-reinterpret-cast",
      "-Wno-shorten-64-to-32",
      "-Wno-implicit-int-conversion",
      "-Wno-float-conversion",
      "-Wno-double-promotion",
      "-Wno-unused-macros",
      "-Wno-global-constructors",
      "-Wno-exit-time-destructors",
      "-Wno-format-nonliteral",
      "-Wno-disabled-macro-expansion",
      "-Wno-switch-enum",
      "-Wno-missing-variable-declarations",
      "-Wno-unused-template",
      "-Wno-covered-switch-default",
      "-Wno-extra-semi-stmt",
      "-Wno-extra-semi",
      "-Wno-unused-parameter",
      "-Wno-shadow",
      "-Wno-missing-prototypes",
      "-Wno-lifetime-safety-intra-tu-suggestions",
      "-Wno-lifetime-safety-cross-tu-suggestions",

      # The lifetime-safety-* warnings are part of an experimental analysis.
      # Many individual diagnostics (like
      # -Wlifetime-safety-lifetimebound-violation) are not yet mapped to
      # toggleable warning flags, so we suppress the entire group and disable
      # the analysis pass.
      "-Wno-lifetime-safety",
      "-Wno-lifetime-safety-all",
      "-Xclang",
      "-fno-lifetime-safety-inference",
      "-Xclang",
      "-fno-experimental-lifetime-safety-tu-analysis",
      "-Wno-switch-default",
      "-Wno-undefined-func-template",
      "-Wno-weak-vtables",
      "-Wno-missing-noreturn",
      "-Wno-unreachable-code-aggressive",
      "-Wno-cast-qual",
      "-Wno-range-loop-analysis",
      "-Wno-implicit-float-conversion",
      "-Wno-nullable-to-nonnull-conversion",
      "-Wno-inconsistent-missing-destructor-override",
      "-Wno-suggest-destructor-override",
      "-Wno-suggest-override",
      "-Wno-float-equal",
      "-Wno-shadow-header",
      "-Wno-c2y-extensions",
      "-Wno-c++20-extensions",
      "-Wno-documentation-unknown-command",
      "-Wno-documentation",
      "-Wno-nrvo",
      "-Wno-non-virtual-dtor",
      "-Wno-reserved-identifier",
      "-Wno-deprecated-redundant-constexpr-static-def",
      "-Wno-unused-member-function",
      "-Wno-tautological-type-limit-compare",
      "-Wno-used-but-marked-unused",
      "-Wno-thread-safety",
      "-Wno-objc-messaging-id",
      "-Wno-unsafe-buffer-usage",
      "-Wno-unique-object-duplication",
    ]

    # Treat third_party and gen headers as system headers to suppress warnings.
    # We use both absolute and relative paths to ensure they match how the
    # compiler sees them.
    _prefixes = [
      rebase_path("${dawn_root}/third_party/", root_build_dir),
      rebase_path("${dawn_root}/third_party/", ""),
      rebase_path("${dawn_root}/buildtools/", root_build_dir),
      rebase_path("${dawn_root}/buildtools/", ""),
      "gen/",
      rebase_path(root_gen_dir, root_build_dir) + "/",
    ]
    foreach(_prefix, _prefixes) {
      cflags += [ "--system-header-prefix=${_prefix}" ]
    }
  }
}
