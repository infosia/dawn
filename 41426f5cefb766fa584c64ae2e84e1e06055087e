      },
      "writtenOn": "2025-07-09T22:25:07Z",
      "side": 1,
      "message": "Does this actually need to be exposed upwards in the API?",
      "range": {
        "startLine": 133,
        "startChar": 16,
        "endLine": 134,
        "endChar": 32
      },
      "revId": "41426f5cefb766fa584c64ae2e84e1e06055087e",
