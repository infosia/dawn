#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  texture2d<float, access::sample> tex;
  sampler sam;
};

fragment void v(texture2d<float, access::sample> tex [[texture(0)]], sampler sam [[sampler(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.tex=tex, .sam=sam};
  float4 res = tint_module_vars.tex.sample(tint_module_vars.sam, float2(1.0f), level(0.0f), int2(1));
}
