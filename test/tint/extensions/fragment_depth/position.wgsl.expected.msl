//
// any
//
#include <metal_stdlib>
using namespace metal;

struct any_outputs {
  float tint_symbol [[depth(any)]];
};

float any_inner(float4 position) {
  return 1.0f;
}

fragment any_outputs any(float4 position [[position]]) {
  any_outputs tint_wrapper_result = {};
  tint_wrapper_result.tint_symbol = any_inner(position);
  return tint_wrapper_result;
}
