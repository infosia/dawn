#include <metal_stdlib>
using namespace metal;

$B1: {  # root
  %a:ptr<storage, array<atomic<u64>>, read_write> = var undef @binding_point(0, 0)
  %other:ptr<storage, u32, read> = var undef @binding_point(0, 1)
}

%main = @fragment func():void {
  $B2: {
    %4:ptr<storage, atomic<u64>, read_write> = access %a, 0i
    %5:u64 = bitcast vec2<u32>(0u)
    %6:void = atomicStoreMax %4, %5
    ret
  }
}

struct tint_module_vars_struct {
  device tint_array<atomic_ulong, 1>* a;
  const constant tint_array<uint4, 1>* tint_storage_buffer_sizes;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_0;
};

fragment void v(device tint_array<atomic_ulong, 1>* a [[buffer(0)]], const constant tint_array<uint4, 1>* tint_storage_buffer_sizes [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.a=a, .tint_storage_buffer_sizes=tint_storage_buffer_sizes};
  uint const v_1 = (tint_array_lengths_struct{.tint_array_length_0_0=((*tint_module_vars.tint_storage_buffer_sizes)[0u].x / 8u)}.tint_array_length_0_0 - 1u);
  atomic_max_explicit((&(*tint_module_vars.a)[min(uint(0), v_1)]), as_type<ulong>(uint2(0u)), memory_order_relaxed);
}
