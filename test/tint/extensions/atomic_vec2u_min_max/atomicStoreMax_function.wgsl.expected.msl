#include <metal_stdlib>
using namespace metal;

$B1: {  # root
  %a:ptr<storage, atomic<u64>, read_write> = var undef @binding_point(0, 0)
}

%foo = func(%p:ptr<storage, atomic<u64>, read_write>):void {
  $B2: {
    %4:u64 = bitcast vec2<u32>(0u)
    %5:void = atomicStoreMax %p, %4
    ret
  }
}
%main = @fragment func():void {
  $B3: {
    %7:void = call %foo, %a
    ret
  }
}

void foo(device atomic_ulong* const p) {
  atomic_max_explicit(p, as_type<ulong>(uint2(0u)), memory_order_relaxed);
}

fragment void v(device atomic_ulong* a [[buffer(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.a=a};
  foo(tint_module_vars.a);
}
