#include <metal_stdlib>
using namespace metal;

struct main_out {
  float4 out_var_1;
};

struct tint_module_vars_struct {
  thread float4* in_var;
  thread float4* out_var;
};

struct main_outputs {
  float4 main_out_out_var_1 [[color(0)]];
};

void main_1() {
}

main_out main_inner(float4 in_var_param, tint_module_vars_struct tint_module_vars) {
  (*tint_module_vars.in_var) = in_var_param;
  main_1();
  return main_out{.out_var_1=(*tint_module_vars.out_var)};
}

fragment main_outputs v(float4 in_var_param [[position]]) {
  thread float4 in_var = 0.0f;
  thread float4 out_var = 0.0f;
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.in_var=(&in_var), .out_var=(&out_var)};
  main_outputs tint_wrapper_result = {};
  tint_wrapper_result.main_out_out_var_1 = main_inner(in_var_param, tint_module_vars).out_var_1;
  return tint_wrapper_result;
}
