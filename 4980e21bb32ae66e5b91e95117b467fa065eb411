n        %col \u003d OpLoad %v4float %cptr\n               OpStore %out_pos %col\n               OpReturn\n               OpFunctionEnd\n```\n\nExpect:\n```wgsl\nstruct Uniforms_1_1 {\n  m : mat4x4\u003cf32\u003e,\n}\n\n@group(0u) @binding(0u) var\u003cuniform\u003e u : Uniforms_1_1;\n\nvar\u003cprivate\u003e v : vec4\u003cf32\u003e;\n\nfn main_inner() {\n  let v_1 \u003d \u0026(u.m);\n  v \u003d tint_load_row_major_column(v_1, u32(1i));\n}\n\n@vertex\nfn main() -\u003e @builtin(position) vec4\u003cf32\u003e {\n  main_inner();\n  return v;\n}\n\nfn tint_load_row_major_column(v_2 : ptr\u003cuniform, mat4x4\u003cf32\u003e\u003e, v_3 : u32) -\u003e vec4\u003cf32\u003e {\n  return vec4\u003cf32\u003e((*(v_2))[0u][v_3], (*(v_2))[1u][v_3], (*(v_2))[2u][v_3], (*(v_2))[3u][v_3]);\n}\n```\n\nGot:\n```text\nprocess exit status: 133\n\n/redacted/src/tint/lang/core/ir/validator.cc:5464 internal compiler error: \n\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\u003d\u003d IR validation failed before spirv.DecomposeStridedMatrix:\n\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n:17:42 error: access: expected at least 2 operands, got 1\n    %5:ptr\u003cuniform, mat4x4\u003cf32\u003e, read\u003e \u003d access %4\n                                         ^^^^^^\n\n:15:3 note: in block\n  $B2: {\n  ^^^\n\nnote: # Disassembly\nUniforms \u003d struct @align(16) {\n  m:mat4x4\u003cf32\u003e @offset(0), @r