      "writtenOn": "2026-06-18T17:58:02Z",
      "side": 1,
      "message": "IIUC this shouldn\u0027t be necessary. `dawn_weverything` is declared in a `declare_args` block which means the thing after the `\u003d` is its _default_ value but it can still be set by args.gn. So it can just be overridden with `dawn_weverything \u003d true` or `dawn_weverything \u003d false` in GN args.",
      "range": {
        "startLine": 40,
        "startChar": 2,
        "endLine": 40,
        "endChar": 32
