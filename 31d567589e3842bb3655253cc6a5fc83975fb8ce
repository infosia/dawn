      "writtenOn": "2025-05-25T08:33:01Z",
      "side": 1,
      "message": "It looks like `uncachedParseResult` is never used as optional, It\u0027s always asserted to have a value and the constructors always set a value. Could it\u0027s members be inlined here?",
      "range": {
        "startLine": 133,
        "startChar": 4,
        "endLine": 133,
        "endChar": 71
      },
      "revId": "31d567589e3842bb3655253cc6a5fc83975fb8ce",
