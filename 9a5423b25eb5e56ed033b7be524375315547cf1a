      "writtenOn": "2025-12-19T10:33:49Z",
      "side": 1,
      "message": "Any chance to make Graphite require `DawnNative`? `DawnInternalUsages` seems like the wrong feature to associate this with.",
      "parentUuid": "48a576b9_d4852988",
      "revId": "9a5423b25eb5e56ed033b7be524375315547cf1a",
