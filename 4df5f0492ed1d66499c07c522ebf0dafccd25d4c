      "writtenOn": "2025-03-10T21:04:51Z",
      "side": 1,
      "message": "Doesn\u0027t this add all the textures instead of just the ones that use num levels?",
      "revId": "4df5f0492ed1d66499c07c522ebf0dafccd25d4c",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
