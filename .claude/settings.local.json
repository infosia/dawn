  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"\nimport json, sys, re\nd = json.load(sys.stdin)\ncmd = d.get('tool_input', {}).get('command', '')\nif re.search(r'(?<![a-zA-Z])ninja\\\\b', cmd) and 'autoninja' not in cmd:\n    print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse', 'permissionDecision': 'ask', 'permissionDecisionReason': 'Use autoninja instead of ninja for building in this project. Replace ninja with autoninja in your command.'}}))\n\"",
            "timeout": 5,
            "statusMessage": "Checking build command..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"\nimport json, sys, subprocess, os, tempfile\nlock = os.path.join(tempfile.gettempdir(), '.claude_gcf_lock')\nd = json.load(sys.stdin)\ncmd = d.get('tool_input', {}).get('command', '')\nif 'git commit' in cmd and '--amend' in cmd and not os.path.exists(lock):\n    try:\n        open(lock, 'w').close()\n        subprocess.run(['git', 'cl', 'format'], capture_output=True)\n        status = subprocess.run(['git', 'diff', '--name-only'], capture_output=True, text=True)\n        if status.stdout.strip():\n            subprocess.run(['git', 'add', '-A'])\n            subprocess.run(['git', 'commit', '--amend', '--no-edit'])\n            print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PostToolUse', 'additionalContext': 'Hook: git cl format applied and amended into commit.'}}))\n    finally:\n        if os.path.exists(lock): os.remove(lock)\n\"",
            "timeout": 60,
            "statusMessage": "Running git cl format..."
          }
        ]
      }
    ]
