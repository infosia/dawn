      },
      "lineNbr": 382,
      "author": {
        "id": 1002831
      },
      "writtenOn": "2025-07-30T16:29:38Z",
      "side": 1,
      "message": "You could have them as non-static but also non-capturing? Basically it just means that they cannot be called after the scope of the test case, but assuming the calls all happen within the test scope it should be fine?",
      "parentUuid": "baad8a2b_76e47819",
      "range": {
        "startLine": 380,
        "startChar": 4,
        "endLine": 382,
        "endChar": 0
      },
      "revId": "6c8194ba8160c17499025a1c094aec8cd68f7c70",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
