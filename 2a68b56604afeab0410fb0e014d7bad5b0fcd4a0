      "lineNbr": 110,
      "author": {
        "id": 1002241
      },
      "writtenOn": "2025-12-18T20:17:00Z",
      "side": 1,
      "message": "The slot is accessible to the entry point if it covers non-padding bytes, and the var itself is referenced in any way (doesn\u0027t even have to be accessed - we\u0027re not checking that).\n\nAnother way of saying it: \"this is data that this entry point might use\".",
      "parentUuid": "e72324cb_4d2b438e",
      "revId": "2a68b56604afeab0410fb0e014d7bad5b0fcd4a0",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
