        "id": 1000257
      },
      "writtenOn": "2025-12-18T13:43:51Z",
      "side": 1,
      "message": "Should this be something like `Returns an empty bitset if none of the slots in the immediate block are accessed, or there is no immediate block` ?",
      "range": {
        "startLine": 110,
        "startChar": 23,
        "endLine": 110,
        "endChar": 80
      },
      "revId": "2a68b56604afeab0410fb0e014d7bad5b0fcd4a0",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
