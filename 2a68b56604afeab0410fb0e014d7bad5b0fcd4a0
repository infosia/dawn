      "author": {
        "id": 1002241
      },
      "writtenOn": "2025-12-18T15:26:35Z",
      "side": 1,
      "message": "Or just use `std::bitset`.",
      "parentUuid": "2410e029_8754f037",
      "revId": "2a68b56604afeab0410fb0e014d7bad5b0fcd4a0",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
