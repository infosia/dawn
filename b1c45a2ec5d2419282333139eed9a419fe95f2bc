      "writtenOn": "2024-08-23T18:23:04Z",
      "side": 1,
      "message": "I wasn\u0027t able to do this because the html5 js file doesn\u0027t seem to have access to C++ functions (even if I add the appropriate `__deps` stuff for them). But it can access the functions from here, hence why I chose to do this.",
      "parentUuid": "ffda2920_7b38a7f5",
      "revId": "b1c45a2ec5d2419282333139eed9a419fe95f2bc",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
