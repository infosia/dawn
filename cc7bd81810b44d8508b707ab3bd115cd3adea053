      "writtenOn": "2026-06-16T08:28:35Z",
      "side": 1,
      "message": "Please fix this WARNING reported by autoreview issue finding: The `wgpuSharedTextureMemoryEndAccessStateFreeMembers(endState)` call was removed, which causes a memory leak. The `endState.fences` array is allocated by the implementation and must be freed by the caller. Please restore the call.",
      "range": {
        "startLine": 458,
        "startChar": 0,
        "endLine": 458,
        "endChar": 0
      },
      "revId": "cc7bd81810b44d8508b707ab3bd115cd3adea053",
