        "id": 1000257
      },
      "writtenOn": "2025-02-11T18:26:03Z",
      "side": 1,
      "message": "Why? We can do constant validation at any stage can we not? Wouldn\u0027t it catch the case where we accidentally create a const-validation error in a later transform?",
      "parentUuid": "b46e08c4_b173adcb",
      "revId": "896a0bf3a4d59bffdf3eedc6e6828a2c6b3194c0",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
