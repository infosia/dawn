      },
      "writtenOn": "2025-11-03T20:15:10Z",
      "side": 1,
      "message": "Unfortunately, I don\u0027t think `IsFrameCapturing` is what we want. I opened [this issue](https://github.com/baldurk/renderdoc/issues/3726) to ask for this feature.",
      "parentUuid": "62f955df_3e26f822",
      "range": {
        "startLine": 713,
        "startChar": 13,
        "endLine": 713,
        "endChar": 44
      },
      "revId": "a4081b5c572418367c9876d94c942e5e0f16a261",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
