      "writtenOn": "2026-02-03T14:18:14Z",
      "side": 1,
      "message": "Why do we need this? It sounds that with eager mapping this whole function should just be a noop.",
      "range": {
        "startLine": 612,
        "startChar": 0,
        "endLine": 615,
        "endChar": 9
      },
      "revId": "a335988ca841282f1e2ad9882553e5cee907d5f0",
