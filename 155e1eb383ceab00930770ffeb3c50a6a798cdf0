      "writtenOn": "2024-10-07T08:16:57Z",
      "side": 1,
      "message": "Maybe to shield implementation details if we decide to split tables, this should be split into a per-object function as well. Otherwise we wouldn\u0027t know which table to address (or would need a GetType() virtual method, but maybe we don\u0027t want that in emscripten).",
      "range": {
        "startLine": 118,
        "startChar": 4,
        "endLine": 118,
        "endChar": 15
      },
      "revId": "155e1eb383ceab00930770ffeb3c50a6a798cdf0",
