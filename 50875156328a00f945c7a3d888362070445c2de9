      "writtenOn": "2026-06-16T00:27:01Z",
      "side": 1,
      "message": "I don\u0027t like `TSpan` either, it looks like a template parameter.\n\nThis is basically just `ityp::span` right? Can we just not define this at all, and redefine `ityp::span` this way? (Perhaps there\u0027s also a question here of why this isn\u0027t in `ityp`.)",
      "parentUuid": "39ac422e_95be095b",
      "revId": "50875156328a00f945c7a3d888362070445c2de9",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
