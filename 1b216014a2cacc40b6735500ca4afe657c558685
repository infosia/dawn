      },
      "lineNbr": 1481,
      "author": {
        "id": 3461520
      },
      "writtenOn": "2026-04-15T14:13:14Z",
      "side": 1,
      "message": "These kinds of asserts are the ones we want to check as it is checking alignment or offsets of memory.\nAlso these are all cheap.",
      "parentUuid": "6d07991d_244c6fee",
      "range": {
        "startLine": 1481,
        "startChar": 8,
        "endLine": 1481,
        "endChar": 18
