      "message": "(Corentin)\nHandleInheritStates is only needed because the code handling SetImmediate/SetBindGroup is the one updating the result.\n\nInstead we could have:\n```\ntemplate\u003ctypename Pass\u003e\n   void SetStorageBuffer(Pass pass,\n                          StorageBufferCount count,\n                          const std::array\u003cSize, 3\u003e\u0026 bufferSizes) {\n        pass.SetBindGroup(\n            0, MakeBindGroupWithBuffers(MakeStorageBindGroupLayout(count), count, bufferSizes));\n        mCurrentBufferLength \u003d ...;\n        // This one is done before the operation instead\n        // wgpu::BindGroup resultBindGroup \u003d MakeResultBindGroup();\n        // pass.SetBindGroup(1, resultBindGroup);\n    }\n\n    template\u003ctypename Pass\u003e\n    void SetImmediates(Pass pass, const std::vector\u003cuint32_t\u003e\u0026 immediates) {\n        std::vector\u003cuint32_t\u003e immediateData;\n        immediateData.push_back(resultIndex);  // First value is always the draw call index\n        immediateData.insert(immediateData.end(), immediates.begin(), immediates.end());\n        pass.SetImmediateData(0, reinterpret_cast\u003cuint8_t*\u003e(immediateData.data()),\n                              immediateData.size() * sizeof(uint32_t));\n\n        Copy immediates at the start of mCurrentImmediates\n    }\n\n\n    void UseRenderPipeline(wgpu::RenderPassEncoder pass,\n                           uint32_t immediateCount,\n                           StorageBufferCount bufferCount) {\n        mCurrentPipelineImmediateCOunt \u003d ..\n        // same for buffer\n        // We no longer need to keep the whole history.\n        pass.SetPipeline(MakeRenderPipelineWithImmediateAndBuffers(immediateCount, bufferCount));\n    }\n\n\n   void Draw(wgpu::RenderPassEncoder pass) {\n        if(resultIndex \u003d\u003d 0) {\n          wgpu::BindGroup resultBindGroup \u003d MakeResultBindGroup();\n          pass.SetBindGroup(1, resultBindGroup);\n        }\n\n        pass.Draw(1);\n\n        OnOperationWritingExpected()\n    }\n\n    void OnOperationWritingExpected() {\n        startOffset \u003d ;\n        for (mCurrentPipelineImmadeatCount) {\n            copy from mCurrentImmediates to mExpectedResults\n        }\n         for (mCurrentPipelineBufferCount) {\n            copy from mCurrentBufferSizes to mExpectedResults\n        }   \n\n        resultIndex++;\n    }\n```",
