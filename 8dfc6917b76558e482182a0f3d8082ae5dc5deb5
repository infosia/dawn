    {
      "unresolved": true,
      "key": {
        "uuid": "a75885e5_da3fb7e8",
        "filename": "src/tint/cmd/fuzz/ir/fuzz.cc",
        "patchSetId": 1
      },
      "lineNbr": 134,
      "author": {
        "id": 1000250
      },
      "writtenOn": "2024-11-25T21:30:46Z",
      "side": 1,
      "message": "Failing to validate before running indicates the the input from the fuzzer is inappropriate for this fuzzing pass, i.e. it violates the pre-conditions for it, but the validator will filter it out, so the test case doesn\u0027t need to run (and probably shouldn\u0027t since it is likely to cause false-positive cases).\n\nFailing validation after running indicates that the fuzzing pass itself, i.e. transform, did some wrong and has violated its own post-conditions, which is one class of errors the fuzzer is trying to find.",
      "parentUuid": "14be1b15_1194e7de",
      "range": {
        "startLine": 133,
        "startChar": 20,
        "endLine": 134,
        "endChar": 33
