      "writtenOn": "2024-11-25T20:49:18Z",
      "side": 1,
      "message": "Why do we `TINT_ICE` for post_capabilities, but not for pre?",
      "range": {
        "startLine": 133,
        "startChar": 20,
        "endLine": 134,
        "endChar": 33
      },
      "revId": "8dfc6917b76558e482182a0f3d8082ae5dc5deb5",
