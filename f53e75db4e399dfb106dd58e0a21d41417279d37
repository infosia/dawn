      "writtenOn": "2024-08-07T21:30:19Z",
      "side": 1,
      "message": "Here\u0027s the original CL: https://dawn-review.googlesource.com/c/dawn/+/101720\n\nSadly, I didn\u0027t mention why rounding up for struct members was necessary.",
      "parentUuid": "27f3ec32_148b04ec",
      "revId": "f53e75db4e399dfb106dd58e0a21d41417279d37",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
