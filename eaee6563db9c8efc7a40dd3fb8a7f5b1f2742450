      },
      "writtenOn": "2025-02-26T18:08:32Z",
      "side": 1,
      "message": "or as suggested in other thread, just rename to something like EnforcesCompatibilityMode or HasCompatibilityModeValidation",
      "parentUuid": "b748e989_c859d79d",
      "revId": "eaee6563db9c8efc7a40dd3fb8a7f5b1f2742450",
