load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "templates",
    srcs = ["templates.go"],
    importpath = "dawn.googlesource.com/dawn/tools/src/cmd/gen/templates",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/src/cmd/gen/common",
        "//tools/src/container",
        "//tools/src/fileutils",
        "//tools/src/glob",
        "//tools/src/oswrapper",
        "//tools/src/template",
        "//tools/src/tint/intrinsic/gen",
        "//tools/src/tint/intrinsic/parser",
        "//tools/src/tint/intrinsic/resolver",
        "//tools/src/tint/intrinsic/sem",
    ],
)

go_test(
    name = "templates_test",
    srcs = ["templates_test.go"],
    embed = [":templates"],
    deps = [
        "//tools/src/cmd/gen/common",
        "//tools/src/container",
        "//tools/src/fileutils",
        "//tools/src/oswrapper",
        "//tools/src/tint/intrinsic/sem",
        "@com_github_stretchr_testify//require:go_default_library",
    ],
)
