      "lineNbr": 213,
      "author": {
        "id": 1000122
      },
      "writtenOn": "2024-11-22T16:11:52Z",
      "side": 1,
      "message": "I think that we could just say that `sampledTextureBinding` is for Vulkan only and disallow it from being used on other backends. AFAIK there aren\u0027t any use cases for those other backends.",
      "parentUuid": "15a90a15_6df2c58c",
      "revId": "729d16fa67944981ad5bf7aeaffe73efd2982156",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
