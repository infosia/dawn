        "id": 1000480
      },
      "writtenOn": "2025-04-23T09:19:34Z",
      "side": 1,
      "message": "I\u0027ve added a separate extension struct as suggested. Please let me know if that looks good to you. There are sadly some tests that rely on the fact that requestDevice can be called multiple times, I\u0027ll have to update them as well...",
      "parentUuid": "65a76243_2aea6e16",
      "revId": "f764f8c7807d133d318ad8096f7183d116945eeb",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
