        "id": 1002831
      },
      "writtenOn": "2025-01-07T22:08:52Z",
      "side": 1,
      "message": "This is a good point that maybe we don\u0027t actually need the full concept of the `struct ImmediateConstant` below.",
      "parentUuid": "1c384a35_c82d1565",
      "range": {
        "startLine": 71,
        "startChar": 0,
        "endLine": 78,
        "endChar": 2
