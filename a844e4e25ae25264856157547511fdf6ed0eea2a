      "writtenOn": "2024-10-21T13:50:31Z",
      "side": 1,
      "message": "As discussed offline, I\u0027ve proceeded to a first pass of comments",
      "revId": "a844e4e25ae25264856157547511fdf6ed0eea2a",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
