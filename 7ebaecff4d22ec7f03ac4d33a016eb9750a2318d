    {
      "unresolved": true,
      "key": {
        "uuid": "e53b05c9_eee83662",
        "filename": "/COMMIT_MSG",
        "patchSetId": 5
      },
      "lineNbr": 17,
      "author": {
        "id": 1001591
      },
      "writtenOn": "2025-11-10T18:06:34Z",
      "side": 1,
      "message": "Smaller writes appear to be the same speed on most devices. The outlier is Windows where some of the times can come back higher for small uploads but the timing is very noisy. For example, on my Windows machine a 1Mb WriteBuffer call appeared on average to be 0.08ms slower (0.63ms vs 0.55ms) with this change, while on every other tested device the timings were the same or better.\n\nWe could put back in a heuristic where we continue using the previous method for Windows uploads under 4Mb only, and that would cover the only potential regressions we\u0027ve seen.",
      "parentUuid": "376281d8_5bf98c2a",
      "revId": "7ebaecff4d22ec7f03ac4d33a016eb9750a2318d",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
