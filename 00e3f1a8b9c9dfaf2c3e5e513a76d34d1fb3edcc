      "lineNbr": 118,
      "author": {
        "id": 1000002
      },
      "writtenOn": "2025-09-03T08:15:50Z",
      "side": 1,
      "message": "Isn\u0027t that done automatically in D3D12 when submitting to the queue? https://learn.microsoft.com/en-us/windows/win32/api/d3d12/ns-d3d12-d3d12_feature_data_architecture doesn\u0027t mention a flush being necessary when !ccUMA.",
      "parentUuid": "e4aef370_59667cfb",
      "revId": "00e3f1a8b9c9dfaf2c3e5e513a76d34d1fb3edcc",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
