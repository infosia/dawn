esultBindGroup);\n        }\n\n        pass.Draw(1);\n        \n        OnOperationWritingExpected()\n    }\n    \n    void OnOperationWritingExpected() {\n        startOffset \u003d ;\n        for (mCurrentPipelineImmadeatCount) {\n            copy from mCurrentImmediates to mExpectedResults\n        }\n         for (mCurrentPipelineBufferCount) {\n            copy from mCurrentBufferSizes to mExpectedResults\n        }   \n\n        resultIndex++;\n    }\n```",
