      "writtenOn": "2025-02-17T08:58:17Z",
      "side": 1,
      "message": "Note: we should remove this API usage in Chromium and use `SharedTextureMemoryEndAccessState::initialized`.",
      "revId": "f263ec69dbf4414a971071a6efa3aeff5106f9c9",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
    {
      "unresolved": false,
      "key": {
