      },
      "lineNbr": 374,
      "author": {
        "id": 1002296
      },
      "writtenOn": "2026-02-13T21:59:35Z",
      "side": 1,
      "message": "(Bear in mind that AL exists and the GPUs can be IMRs)",
      "parentUuid": "fb30b195_d6396e72",
      "revId": "abbcbf94a1d3e9ee8c789632f83b931a13d37c1e",
