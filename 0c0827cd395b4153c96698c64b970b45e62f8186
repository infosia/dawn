      "writtenOn": "2025-11-25T07:26:42Z",
      "side": 1,
      "message": "Now I don\u0027t set `VK_PIPELINE_SHADER_STAGE_CREATE_ALLOW_VARYING_SUBGROUP_SIZE_BIT` when `VkPipelineShaderStageRequiredSubgroupSizeCreateInfoEXT` is enabled.",
      "parentUuid": "c961b78b_6ded7ca8",
      "revId": "0c0827cd395b4153c96698c64b970b45e62f8186",
