              },
              "replacement": "    CheckIOAttributes(func, func-\u003eReturnAttributes(), func-\u003eReturnType(),\n                       is_not_struct_impl, is_struct_impl);\n"
            },
            {
              "path": "src/tint/lang/core/ir/validator.cc",
              "range": {
                "startLine": 203,
                "startChar": 0,
                "endLine": 205,
                "endChar": 0
              },
              "replacement": "    CheckIOAttributes(param-\u003eFunction(), param-\u003eAttributes(), param-\u003eType(),\n                       is_not_struct_impl, is_struct_impl);\n"
            },
            {
