        "id": 1000002
      },
      "writtenOn": "2024-10-09T16:26:30Z",
      "side": 1,
      "message": "Note: in the future it could be better to have a set of caches to flush on the device, and iterate it when performing idle tasks.",
      "revId": "801395426cf81aab67050db88e23d4d99b03eed5",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
