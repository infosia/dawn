      "writtenOn": "2025-01-07T02:57:49Z",
      "side": 1,
      "message": "In this CL we enable the feature on Vulkan so the test can be run on Vulkan, then we will hit the assert.\n\nWithout this CL these tests won\u0027t be executed on Vulkan as the feature is not enabled on Vulkan.",
      "parentUuid": "4607f0e5_e9322bcb",
      "range": {
        "startLine": 726,
        "startChar": 20,
        "endLine": 726,
        "endChar": 72
