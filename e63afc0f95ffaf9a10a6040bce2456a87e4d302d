      "writtenOn": "2025-09-09T17:21:35Z",
      "side": 1,
      "message": "```suggestion\nbool ReadStdinImpl(std::vector\u003cT\u003e* buffer) {\n    buffer-\u003eclear();\n    SetStdinModeBinary();\n\n    constexpr size_t kItemsPerChunk \u003d 1024;\n    constexpr size_t kBytesPerChunk \u003d sizeof(T) * kItemsPerChunk;\n    std::vector\u003cT\u003e chunk(kItemsPerChunk);\n\n    while (!feof(stdin)) {\n        size_t bytes_read \u003d fread(chunk.data(), 1, kBytesPerChunk, stdin);\n        size_t items_read \u003d bytes_read / sizeof(T);\n        if (bytes_read \u003d\u003d 0) {\n            if (ferror(stdin)) {\n                std::cerr \u003c\u003c \"Error reading from standard input\\n\";\n                return false;\n            }\n            // EOF\n            break;\n        }\n\n        if (bytes_read % sizeof(T) !\u003d 0) {\n            std::cerr \u003c\u003c \"Encountered non-aligned read from input stream, read \u0027\" \u003c\u003c bytes_read\n                      \u003c\u003c \"\u0027 bytes, which is not an integral number of objects of size \u0027\"\n                      \u003c\u003c sizeof(T) \u003c\u003c \"\u0027\\n\";\n            return false;\n        }\n\n        buffer-\u003ereserve(buffer-\u003esize() + items_read);\n        std::copy(chunk.begin(), chunk.end(), std::back_inserter(*buffer));\n    }\n\n    return true;\n}\n```",
