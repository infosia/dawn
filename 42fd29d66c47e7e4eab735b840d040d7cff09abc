      },
      "writtenOn": "2024-09-25T16:36:05Z",
      "side": 1,
      "message": "Is that true? I thought it would lookup the symbol, see it exists and give it a name with an appended number?",
      "parentUuid": "9a0870be_b4d132c4",
      "revId": "42fd29d66c47e7e4eab735b840d040d7cff09abc",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
