      "writtenOn": "2025-06-23T08:20:52Z",
      "side": 1,
      "message": "Do we expect to have additional SPIR-V versions supported in the future? It would be worth using an enum as the ValidateSpirv parameter instead of a boolean.",
      "range": {
        "startLine": 391,
        "startChar": 89,
        "endLine": 391,
        "endChar": 94
      },
      "revId": "87f2ce38b5c4252ec534ca119c5cad00cb8f8582",
