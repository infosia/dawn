      "writtenOn": "2026-03-25T20:21:16Z",
      "side": 1,
      "message": "Nope, the way that `MutexCondVarProtected` is implemented guarantees that when we call wait, we release the lock.",
      "parentUuid": "8dbf40c2_e12d8812",
      "range": {
        "startLine": 50,
