      "writtenOn": "2026-03-25T14:42:37Z",
      "side": 1,
      "message": "Does this end up holding the mState lock while waiting? Wouldn\u0027t that cause `AsyncTask::Run` to be unable to start or set the completed state?",
      "range": {
        "startLine": 50,
        "startChar": 0,
        "endLine": 52,
        "endChar": 7
      },
      "revId": "364afaca94153254c1f6b19559ff0bfaf2a946a8",
