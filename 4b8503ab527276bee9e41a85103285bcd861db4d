      "writtenOn": "2024-07-17T13:54:37Z",
      "side": 1,
      "message": "Why does the public C++ API use std::optional\u003cstd::string_view\u003e instead of a wgpu::String that has an implicit constructor from std::string_view? (and a default constructor being the same as constructing from nullptr)?",
      "revId": "4b8503ab527276bee9e41a85103285bcd861db4d",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
