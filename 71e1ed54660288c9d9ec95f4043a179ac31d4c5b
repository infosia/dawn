      "writtenOn": "2026-01-28T14:49:18Z",
      "side": 1,
      "message": "nvm. I have changed this to cancel the deferred unmap instead. Seems it\u0027s fine to destroy the buffer even if it\u0027s still mapped. At least D3D11 doesn\u0027t complain anything.",
      "parentUuid": "c628d5c5_5dc5988d",
      "revId": "71e1ed54660288c9d9ec95f4043a179ac31d4c5b",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "855eb834_09fd851c",
        "filename": "src/dawn/native/d3d11/BufferD3D11.cpp",
        "patchSetId": 2
      },
      "lineNbr": 605,
      "author": {
        "id": 1000002
