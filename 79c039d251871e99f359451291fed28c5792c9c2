      "writtenOn": "2025-02-14T22:13:03Z",
      "side": 1,
      "message": "Why not just keep the root block at the root of the block stack, since it\u0027s always in scope?",
      "revId": "79c039d251871e99f359451291fed28c5792c9c2",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
