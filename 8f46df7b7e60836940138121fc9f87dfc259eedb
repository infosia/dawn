      "author": {
        "id": 3461520
      },
      "writtenOn": "2025-08-05T14:52:24Z",
      "side": 1,
      "message": "Yes that is correct. We need to know all of the barriers that were emitted AFTER our dispatch call.",
      "parentUuid": "deb366a5_10d31fc5",
      "revId": "8f46df7b7e60836940138121fc9f87dfc259eedb",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
