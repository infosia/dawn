        "id": 1000002
      },
      "writtenOn": "2026-03-27T18:39:16Z",
      "side": 1,
      "message": "It was an attempt to keep the logic to turn the `StaticSamplerSpecialization` into a `SamplerDescriptor` more local. But that\u0027s probably not super needed given how small `SamplerVk.cpp` is. Done",
      "parentUuid": "78da0360_d1d91ef2",
      "revId": "60fe67734a27bf1c642912d28c24990a5927d56d",
      "serverId": "dd02978d-1a8e-36d7-bcc0-a5723e5c0abd"
